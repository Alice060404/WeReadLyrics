<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingTop="12dp"
        android:paddingBottom="32dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/back_to_settings"
            style="@style/Widget.Material3Expressive.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/back_to_settings"
            app:icon="@drawable/ic_back" />
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/personalization_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/personalization_title"
            android:textAppearance="?attr/textAppearanceHeadlineLarge"
            android:textColor="?attr/colorOnSurface" />
        <com.google.android.material.textview.MaterialTextView
            style="@style/Widget.WeReadLyrics.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp"
            android:text="@string/personalization_description" />
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.WeReadLyrics.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/navigation_style_title"
                    style="@style/Widget.WeReadLyrics.Heading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/navigation_style_title" />
                <RadioGroup
                    android:id="@+id/navigation_style_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    android:saveEnabled="false">
                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/navigation_style_glass"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="56dp"
                        android:saveEnabled="false"
                        android:text="@string/navigation_style_glass" />
                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/navigation_style_material"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="56dp"
                        android:saveEnabled="false"
                        android:text="@string/navigation_style_material" />
                </RadioGroup>
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/navigation_style_description"
                    style="@style/Widget.WeReadLyrics.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:accessibilityLiveRegion="polite" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/glass_parameters_card"
            style="@style/Widget.WeReadLyrics.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">
            <LinearLayout
                android:id="@+id/glass_parameters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.WeReadLyrics.Heading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:text="@string/glass_parameters_title" />
                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.WeReadLyrics.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/glass_parameters_hint" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
