<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false">
    <FrameLayout
        android:id="@+id/page_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include android:id="@+id/page_home" layout="@layout/page_home" />
        <include android:id="@+id/page_functions" layout="@layout/page_functions" android:visibility="gone" />
        <include android:id="@+id/page_settings" layout="@layout/page_settings" android:visibility="gone" />
        <include android:id="@+id/page_personalization" layout="@layout/page_personalization" android:visibility="gone" />
    </FrameLayout>
    <io.github.alice060404.wereadlyrics.ui.NavigationBarHostView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="12dp" />
</FrameLayout>
